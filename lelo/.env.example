# Lelo — environment
# Copy to .env and fill in. The service runs with none of these set: every
# external integration falls back to a mock provider, so the whole system is
# demonstrable with no telco, no PSP and no Meta account.
#
# NEVER commit a filled-in copy of this file.

# ── Server ──────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0

# Local SQLite path. Leave unset on Vercel — the filesystem there is
# ephemeral and per-invocation; point the data layer at Supabase instead.
LELO_DB=./data/lelo.db

# ── Service ─────────────────────────────────────────────────────────
SERVICE_NAME=Lelo
USSD_SHORT_CODE=*2255#
SUPPORT_PHONE=+260 972 000 000

# Price per day in ngwee. 100 = K1.00.
DAILY_PRICE_NGWEE=100
TRIAL_DAYS=7
LOW_BALANCE_NGWEE=200

# ── Supabase (production data layer) ────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Safe to expose to a browser. Used by the public landing page only.
SUPABASE_ANON_KEY=
# NEVER expose this. It bypasses Row Level Security. Server-side only —
# not in a Lovable front end, not in any NEXT_PUBLIC_* or VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# ── SMS / USSD aggregator ───────────────────────────────────────────
# mock | http
MESSAGING_PROVIDER=mock
SMS_SENDER_ID=LELO
SMS_API_URL=
SMS_API_KEY=

# ── WhatsApp Business Platform (Cloud API) ──────────────────────────
# You choose WHATSAPP_VERIFY_TOKEN yourself and paste the same string into
# the Meta webhook configuration screen.
WHATSAPP_VERIFY_TOKEN=
# From Meta app settings. Used to check X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0

# ── Payment Service Provider ────────────────────────────────────────
# mock | http. The PSP is merchant of record for all collections; we never
# hold a mobile-money float ourselves. See docs/COMPLIANCE.md.
PSP_PROVIDER=mock
PSP_API_URL=
PSP_API_KEY=
# HMAC-SHA256 secret for settlement webhooks. Without it, signature
# verification fails closed and no webhook is accepted.
PSP_WEBHOOK_SECRET=

# ── Scheduled work & admin ──────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
ADMIN_TOKEN=
