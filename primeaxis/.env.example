# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://primeaxis:primeaxis@localhost:5432/primeaxis?schema=public
POSTGRES_USER=primeaxis
POSTGRES_PASSWORD=primeaxis
POSTGRES_DB=primeaxis

# ── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=4000
# 64+ random chars: `openssl rand -hex 64`
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated origins allowed for CORS + WebSocket
CORS_ORIGINS=http://localhost:3000

# ── Frontend (apps/web) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=PrimeAxis

# ── Stripe (cards: Visa / Mastercard) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Price IDs created in the Stripe dashboard (one per paid plan, monthly)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_WEBHOOK_ID=...

# ── Coinbase Commerce (BTC / ETH / USDC / LTC …) ────────────────────────────
COINBASE_COMMERCE_API_KEY=...
COINBASE_COMMERCE_WEBHOOK_SECRET=...

# ── Optional: mobile-money gateway of your region (extension point) ─────────
# MOMO_PROVIDER=mtn|airtel
# MOMO_API_KEY=...
