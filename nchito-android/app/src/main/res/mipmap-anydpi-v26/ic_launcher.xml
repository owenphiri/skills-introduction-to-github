<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for API 26+. The launcher masks these two layers to whatever
  shape the device uses — circle, squircle, rounded square — so the mark sits
  inset in the foreground and the brand green fills the background.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
