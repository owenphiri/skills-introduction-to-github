# Local development server (scripts/dev-server.js / `npm run dev`)
HOST=localhost
PORT=3000

# Production domain — left blank until a domain is purchased.
# Once you have one, set it as a repository *variable* (not secret, it's not
# sensitive) named PRODUCTION_DOMAIN under GitHub repo Settings > Secrets and
# variables > Actions > Variables. The musenga-mis-deploy.yml workflow reads
# it automatically on every deploy to main; nothing else needs to change.
# Until then, the app is reachable at the *.vercel.app URL Vercel assigns it.
PRODUCTION_DOMAIN=

# --- AI Teacher Assistant (api/ai/*.js — Vercel serverless functions) ---
# These are read by the API, not the static frontend, so they only need to
# be set as Vercel Project > Settings > Environment Variables (this file is
# NOT read by the deployed app; it's a local-dev reference only, and
# `npm run dev`'s plain static server doesn't serve /api routes at all —
# use `vercel dev` to test AI features locally). See docs/DEPLOYMENT.md.

# Required for schemes of work, lesson plans, quizzes and the coding tutor.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

# Optional — only for the multi-tenant-ready usage/telemetry log
# (supabase/schema.sql). AI features work fully without these; usage
# just won't be logged anywhere.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
